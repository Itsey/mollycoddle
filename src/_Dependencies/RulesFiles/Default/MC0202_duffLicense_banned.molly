{
    "Rules": [
        {
            "Link": "https://itsey.github.io/molly-rules.html#MC0202",
            "Name": "Packages which changed their licensing are banned.",
            "RuleReference": "MC0202",
            "Validators": [
                {
                    "AdditionalData": [
                        "fluentassertions[>7.9.9]"
                    ],
                    "Control": "ProhibitedPackagesList",
                    "PatternMatch": "**\\*.csproj",
                    "ValidatorName": "NugetValidationChecks"
                }
            ]
        }
    ],
    "RulesetName": "Basic Quality Rules"
}